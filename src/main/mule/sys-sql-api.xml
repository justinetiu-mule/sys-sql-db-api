		<logger level="INFO" doc:name="End of Retrieve Sales Details Flow" doc:id="d358b8ae-6b53-4c05-964c-94e8adba2f10" message='#[output application/json&#10;---&#10;{&#10;	message: "End of Retrieve Sales Details Flow",&#10;	correlationId: vars.correlationId,&#10;	appName: vars.appName,&#10;	data: {&#10;		transactionId: vars.transactionId&#10;	}&#10;}]'/>
    </flow>
