    <flow name="get:\sales\(transactionId):sys-sql-api-config" doc:id="37f6ec95-ee24-4fb1-a51e-e889f8d1cd15">
        <ee:transform doc:name="Set transactionId Variable" doc:id="bd472743-8c47-49e6-a598-467ee2e6135f">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="transactionId" ><![CDATA[%dw 2.0
output application/java
---
attributes.uriParams.transactionId]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="Start of Retrieve Sales Details Flow" doc:id="3bb2fd45-921b-40f4-8a23-8b553e267b0b" message='#[output application/json&#10;---&#10;{&#10;	message: "Start of Retrieve Sales Details Flow",&#10;	correlationId: vars.correlationId,&#10;	appName: vars.appName,&#10;	data: {&#10;		transactionId: vars.transactionId&#10;	}&#10;}]'/>
