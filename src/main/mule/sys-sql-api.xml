    <flow name="sys-sql-api-main" doc:id="aa77bd6b-080e-4d86-9ebb-4182a5c2487b">
        <http:listener config-ref="sys-sql-api-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <ee:transform doc:name="Set correlationId and appName Variable" doc:id="755f3d8e-9ac3-4b7b-8143-9d8894644a17" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="correlationId" ><![CDATA[%dw 2.0
output application/java
---
correlationId]]></ee:set-variable>
				<ee:set-variable variableName="appName" ><![CDATA[%dw 2.0
output application/java
---
Mule::p("app.name")]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<apikit:router config-ref="sys-sql-api-config" />
    </flow>
